{
  "name": "barrio-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Reconoce tu Barrio: El Tintal (Kennedy, Bogotá D.C.) — frontend",
  "author": "Marie Anne Lopez Poveda",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:lines": "node scripts/check_line_length.mjs",
    "sprite": "node scripts/slice_spritesheet.mjs",
    "sprites": "node scripts/build_sprite_scales.mjs",
    "brand": "node scripts/build_brand_assets.mjs",
    "datos:3d": "node scripts/datos3d/build.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "gsap": "3.15.1",
    "i18next": "27.1.1",
    "maplibre-gl": "6.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5",
    "three": "0.172.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.172.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
